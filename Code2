function CheckDCVLogs {

    # ============================================================
    # Configuration
    # ============================================================

    $directoryPath = "C:\ProgramData\NICE\DCV\log"

    $loginSearchText1 = "INFO session - user logged into session"

    $loginSearchText2 = "INFO agentlauncher - The active user has changed from 'none' to"

    # Number of days after which DCV access is considered inactive
    $idleDays = 90

    # Number of attempts to open a busy/locked file
    $maxRetries = 5

    # Time between attempts
    $retryDelayMilliseconds = 2000

    $todayDate = (Get-Date).Date


    # ============================================================
    # Check DCV log directory
    # ============================================================

    if (-not (Test-Path -LiteralPath $directoryPath -PathType Container)) {

        return [PSCustomObject]@{
            Result           = "DCVLogDirectoryNotFound"
            LastLoggedInDate = $null
            Error            = "DCV log directory does not exist: $directoryPath"
        } | ConvertTo-Json -Compress
    }


    # ============================================================
    # Get all DCV server logs
    #
    # Examples:
    #
    # server.log
    # server.log.1
    # server.log.2
    # server.log.3
    #
    # Oldest files are processed first.
    # ============================================================

    try {

        $fileList = @(
            Get-ChildItem `
                -LiteralPath $directoryPath `
                -File `
                -Filter "server.log*" `
                -ErrorAction Stop |
            Sort-Object LastWriteTime
        )

    }
    catch {

        return [PSCustomObject]@{
            Result           = "DCVLogFileEnumerationError"
            LastLoggedInDate = $null
            Error            = $_.Exception.Message
        } | ConvertTo-Json -Compress
    }


    # ============================================================
    # No log files
    # ============================================================

    if ($fileList.Count -eq 0) {

        return [PSCustomObject]@{
            Result           = "DCVLogFileNotFound"
            LastLoggedInDate = $null
            Error            = "No DCV server log files were found."
        } | ConvertTo-Json -Compress
    }


    # ============================================================
    # Store login information by date
    # ============================================================

    $dateMatches = @{}


    # ============================================================
    # Process EVERY log file
    # ============================================================

    foreach ($fileInfo in $fileList) {

        $filePath = $fileInfo.FullName

        $fileStream = $null
        $reader = $null

        $fileOpened = $false
        $lastOpenError = $null


        # ========================================================
        # Open the file
        #
        # IMPORTANT:
        #
        # We DO NOT skip the file if it is locked.
        #
        # We retry several times. If it still cannot be opened,
        # the ENTIRE function stops and returns an error.
        # ========================================================

        for ($attempt = 1; $attempt -le $maxRetries; $attempt++) {

            try {

                $fileStream = [System.IO.File]::Open(
                    $filePath,
                    [System.IO.FileMode]::Open,
                    [System.IO.FileAccess]::Read,
                    (
                        [System.IO.FileShare]::ReadWrite -bor
                        [System.IO.FileShare]::Delete
                    )
                )

                $reader = [System.IO.StreamReader]::new(
                    $fileStream,
                    [System.Text.Encoding]::UTF8,
                    $true
                )

                $fileOpened = $true

                break
            }
            catch {

                $lastOpenError = $_.Exception.Message

                if ($reader) {
                    $reader.Dispose()
                    $reader = $null
                }

                if ($fileStream) {
                    $fileStream.Dispose()
                    $fileStream = $null
                }

                # -----------------------------------------------
                # Do NOT skip the file.
                #
                # Wait and try again.
                # -----------------------------------------------

                if ($attempt -lt $maxRetries) {

                    Start-Sleep -Milliseconds $retryDelayMilliseconds
                }
            }
        }


        # ========================================================
        # File could not be opened after all retries.
        #
        # DO NOT continue to the next file.
        #
        # Returning an error is safer than producing an
        # incorrect Active/Inactive result.
        # ========================================================

        if (-not $fileOpened) {

            return [PSCustomObject]@{
                Result           = "DCVLogReadError"
                LastLoggedInDate = $null
                Error            = "Unable to open DCV log file '$filePath' after $maxRetries attempts. Last error: $lastOpenError"
            } | ConvertTo-Json -Compress
        }


        # ========================================================
        # Read the file
        # ========================================================

        try {

            while (($line = $reader.ReadLine()) -ne $null) {

                # ------------------------------------------------
                # Extract date from beginning of log line
                #
                # Example:
                #
                # 2026-08-09 12:30:45 INFO session ...
                # ------------------------------------------------

                if ($line -notmatch '^\s*(\d{4}-\d{2}-\d{2})\b') {
                    continue
                }

                $logDateString = $matches[1]


                # ------------------------------------------------
                # Parse date
                # ------------------------------------------------

                try {

                    $logDate = [datetime]::ParseExact(
                        $logDateString,
                        "yyyy-MM-dd",
                        [System.Globalization.CultureInfo]::InvariantCulture
                    ).Date

                }
                catch {

                    continue
                }


                # ------------------------------------------------
                # Create date entry
                # ------------------------------------------------

                if (-not $dateMatches.ContainsKey($logDateString)) {

                    $dateMatches[$logDateString] = @{
                        Date          = $logDate
                        Message1Found = $false
                        Message2Found = $false
                    }
                }


                # ------------------------------------------------
                # Search for login message #1
                # ------------------------------------------------

                if (
                    -not $dateMatches[$logDateString].Message1Found -and
                    $line.IndexOf(
                        $loginSearchText1,
                        [System.StringComparison]::OrdinalIgnoreCase
                    ) -ge 0
                ) {

                    $dateMatches[$logDateString].Message1Found = $true
                }


                # ------------------------------------------------
                # Search for login message #2
                # ------------------------------------------------

                if (
                    -not $dateMatches[$logDateString].Message2Found -and
                    $line.IndexOf(
                        $loginSearchText2,
                        [System.StringComparison]::OrdinalIgnoreCase
                    ) -ge 0
                ) {

                    $dateMatches[$logDateString].Message2Found = $true
                }
            }
        }
        catch {

            # ====================================================
            # A read error occurred AFTER successfully opening
            # the file.
            #
            # DO NOT skip the file.
            # DO NOT continue to another file.
            #
            # Return an error because the log history cannot be
            # considered complete/reliable.
            # ====================================================

            if ($reader) {
                $reader.Dispose()
                $reader = $null
            }

            if ($fileStream) {
                $fileStream.Dispose()
                $fileStream = $null
            }

            return [PSCustomObject]@{
                Result           = "DCVLogReadError"
                LastLoggedInDate = $null
                Error            = "Error while reading DCV log file '$filePath': $($_.Exception.Message)"
            } | ConvertTo-Json -Compress
        }
        finally {

            # ====================================================
            # Always release file handles
            # ====================================================

            if ($reader) {
                $reader.Dispose()
                $reader = $null
            }

            if ($fileStream) {
                $fileStream.Dispose()
                $fileStream = $null
            }
        }
    }


    # ============================================================
    # Find dates where BOTH login messages were found
    # ============================================================

    $matchingDates = @(
        $dateMatches.Values |
        Where-Object {
            $_.Message1Found -and $_.Message2Found
        } |
        Sort-Object Date -Descending
    )


    # ============================================================
    # No matching DCV login found
    # ============================================================

    if ($matchingDates.Count -eq 0) {

        return [PSCustomObject]@{
            Result           = "NoDCVLoginFound"
            LastLoggedInDate = $null
            Error            = "No valid DCV login event was found in the available log files."
        } | ConvertTo-Json -Compress
    }


    # ============================================================
    # Get latest valid DCV login
    # ============================================================

    $dcvLastLogin = $matchingDates[0].Date


    # ============================================================
    # Calculate days since last login
    # ============================================================

    $dcvDateDiff = ($todayDate - $dcvLastLogin).Days


    # ============================================================
    # Determine Active / Inactive
    # ============================================================

    if ($dcvDateDiff -le $idleDays) {

        $result = "ActiveDCV"
    }
    else {

        $result = "InactiveDCV"
    }


    # ============================================================
    # Return final result
    # ============================================================

    return [PSCustomObject]@{
        Result           = $result
        LastLoggedInDate = $dcvLastLogin.ToString("yyyy-MM-dd")
        Error            = $null
    } | ConvertTo-Json -Compress
}
