#!/bin/bash

IDLE_DAYS=90

echo "=========================================="
echo "       EC2 Workbench SSH Access Check"
echo "=========================================="

# Find the SSH service name
if systemctl list-units --type=service --all | grep -q "ssh.service"; then
    SSH_SERVICE="ssh"
elif systemctl list-units --type=service --all | grep -q "sshd.service"; then
    SSH_SERVICE="sshd"
else
    echo "ERROR: SSH service not found."
    exit 1
fi

echo "SSH Service : $SSH_SERVICE"
echo ""

# Get the most recent successful SSH login
LAST_LOGIN=$(sudo journalctl -u "$SSH_SERVICE" \
    --no-pager \
    -o short-iso \
    | grep -E "Accepted .* for " \
    | tail -1)

if [ -z "$LAST_LOGIN" ]; then
    echo "Last SSH Login : No successful SSH login found"
    echo "90-Day Status  : NO SSH ACCESS FOUND"
    exit 0
fi

echo "Last SSH Login :"
echo "$LAST_LOGIN"
echo ""

# Extract username
LAST_USER=$(echo "$LAST_LOGIN" | sed -n 's/.*Accepted .* for \([^ ]*\) from .*/\1/p')

echo "Last SSH User  : $LAST_USER"
echo ""

# Check for successful SSH login within last 90 days
RECENT_LOGIN=$(sudo journalctl -u "$SSH_SERVICE" \
    --since "$IDLE_DAYS days ago" \
    --no-pager \
    | grep -E "Accepted .* for " \
    | tail -1)

if [ -n "$RECENT_LOGIN" ]; then
    echo "90-Day Status  : ACCESSED"
else
    echo "90-Day Status  : NOT ACCESSED"
fi

echo "=========================================="